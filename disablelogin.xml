<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
	<name>PLG_HRZ_DISABLELOGIN</name>
	<author>Stefan Herzog, COBIZ Webdevelopment</author>
	<creationDate>August 2026</creationDate>
	<copyright>(C) 2021 Stefan Herzog. All rights reserved.</copyright>
	<license>GNU General Public License version 3 or later; see LICENSE.txt</license>
	<authorEmail>joomla@devel.stefan-herzog.com</authorEmail>
	<authorUrl>github.com/alve89 cobiz.nl</authorUrl>
	<version>1.1.2</version>
	<description>PLG_HRZ_DISABLELOGIN_DESCRIPTION</description>

	<namespace path="src">Joomla\Plugin\System\DisableLogin</namespace>

	<files>
		<folder plugin="disablelogin">services</folder>
		<folder>src</folder>
		<filename>index.html</filename>
	</files>

	<languages folder="language">
		<language tag="de-DE">de-DE/de-DE.plg_system_disablelogin.ini</language>
		<language tag="de-DE">de-DE/de-DE.plg_system_disablelogin.sys.ini</language>
		<language tag="en-GB">en-GB/en-GB.plg_system_disablelogin.ini</language>
		<language tag="en-GB">en-GB/en-GB.plg_system_disablelogin.sys.ini</language>
		<language tag="nl-NL">nl-NL/nl-NL.plg_system_disablelogin.ini</language>
		<language tag="nl-NL">nl-NL/nl-NL.plg_system_disablelogin.sys.ini</language>
		<language tag="pt-BR">pt-BR/pt-BR.plg_system_disablelogin.ini</language>
		<language tag="pt-BR">pt-BR/pt-BR.plg_system_disablelogin.sys.ini</language>
	</languages>

	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="enableLogging"
					type="radio"
					default="0"
					label="PLG_HRZ_DISABLELOGIN_FIELD_ENABLELOGGING_LABEL"
					description="PLG_HRZ_DISABLELOGIN_FIELD_ENABLELOGGING_DESC"
					class="btn-group btn-group-yesno">
						<option value="1">JYES</option>
						<option value="0">JNO</option>
				</field>

				<field
					name="secretKey"
					type="text"
					filter="string"
					placeholder="PLG_HRZ_DISABLELOGIN_FIELD_SECRETKEY_PLACEHOLDER"
					label="PLG_HRZ_DISABLELOGIN_FIELD_SECRETKEY_LABEL"
					description="PLG_HRZ_DISABLELOGIN_FIELD_SECRETKEY_DESC"
					/>

				<field
					name="messageOutput"
					type="radio"
					default="0"
					label="PLG_HRZ_DISABLELOGIN_FIELD_MESSAGEOUTPUT_LABEL"
					description="PLG_HRZ_DISABLELOGIN_FIELD_MESSAGEOUTPUT_DESC"
					class="btn-group btn-group-yesno">
						<option value="1">JYES</option>
						<option value="0">JNO</option>
				</field>

				<field name="redirectUrl"
				 type="url"
				 size="50"
				 placeholder="/path/relative/to/JoomlaRoot/ or http://myDomain.tld"
				 label="PLG_HRZ_DISABLELOGIN_FIELD_REDIRECTURL_LABEL"
				 description="PLG_HRZ_DISABLELOGIN_FIELD_REDIRECTURL_DESC" />

			</fieldset>

			<fieldset name="hardening" label="PLG_HRZ_DISABLELOGIN_FIELDSET_HARDENING_LABEL">

				<field
					name="persistUnlock"
					type="radio"
					default="1"
					label="PLG_HRZ_DISABLELOGIN_FIELD_PERSISTUNLOCK_LABEL"
					description="PLG_HRZ_DISABLELOGIN_FIELD_PERSISTUNLOCK_DESC"
					class="btn-group btn-group-yesno">
						<option value="1">JYES</option>
						<option value="0">JNO</option>
				</field>

				<field
					name="blockApi"
					type="radio"
					default="0"
					label="PLG_HRZ_DISABLELOGIN_FIELD_BLOCKAPI_LABEL"
					description="PLG_HRZ_DISABLELOGIN_FIELD_BLOCKAPI_DESC"
					class="btn-group btn-group-yesno">
						<option value="1">JYES</option>
						<option value="0">JNO</option>
				</field>

				<field
					name="allowedIPs"
					type="textarea"
					rows="4"
					cols="40"
					placeholder="203.0.113.4&#10;198.51.100.0/24"
					label="PLG_HRZ_DISABLELOGIN_FIELD_ALLOWEDIPS_LABEL"
					description="PLG_HRZ_DISABLELOGIN_FIELD_ALLOWEDIPS_DESC"
					/>

			</fieldset>
		</fields>
	</config>

	<updateservers>
  		<server type="extension" priority="1" name="PLG_HRZ_DISABLELOGIN">https://raw.githubusercontent.com/alve89/j_plg_hrz_disablelogin/master/updates.xml</server>
	</updateservers>
</extension>
